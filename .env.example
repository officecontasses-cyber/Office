# Copie para .env (que NÃO vai para o Git). Nunca coloque senha aqui no chat.
# Etapas 1-3 não precisam de nenhuma credencial.
# Etapa 5 (portal): preferir sessão já logada da Fernanda no Chrome.
ISSQN_PASTA_ENTRADA=entrada
ISSQN_PASTA_SAIDA=saida

# Etapa A: endereço pelo qual você entra no portal da prefeitura (login por certificado digital, sem senha)
ISSQN_PORTAL_URL=
ISSQN_PERFIL_NAVEGADOR=perfil_navegador
# Opcional: caminho de outro Chrome/Chromium. Em branco usa o Chrome instalado.
ISSQN_CHROME_PATH=
